# Copy to .env.prod (git-ignored) and replace every value. Used by docker-compose.prod.yml:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Make secrets with: openssl rand -base64 24
# APP_KEY: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=http://localhost:8080
WEB_PORT=8080
DB_PASSWORD=
S3_ACCESS_KEY=figurepose
S3_SECRET_KEY=
# Locally, reuse the dev stack's downloaded models instead of fetching 1.3 GB again.
MODEL_CACHE_VOLUME=figurepose_model_cache
# AI visuals stay off until a real image provider is connected.
GENERATION_ENABLED=false
AI_GENERATION_PROVIDER=none
# A real image service: set both, plus GENERATION_ENABLED=true above.
# AI_GENERATION_PROVIDER=openai
# GENERATION_PROVIDER_NAME=OpenAI
# OPENAI_API_KEY=
# Naming the figure's character (optional): AI_IDENTIFY_PROVIDER=openai, CHARACTER_RECOGNITION_ENABLED=true,
# CHARACTER_PROVIDER_NAME=OpenAI, plus OPENAI_API_KEY above.
