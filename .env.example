# Copy to .env (git-ignored) and change the values. Used by docker-compose.yml.
DB_PASSWORD=change-me-db
S3_ACCESS_KEY=figurepose
S3_SECRET_KEY=change-me-storage

# AI visuals with a real image service (optional; default is the free stub). Every visual is billed.
# AI_GENERATION_PROVIDER=openai
# GENERATION_PROVIDER_NAME=OpenAI
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_IMAGE_QUALITY=medium
# Naming the figure's character for pose ideas (optional; otherwise the user types it). Billed per photo.
# AI_IDENTIFY_PROVIDER=openai
# CHARACTER_RECOGNITION_ENABLED=true
# CHARACTER_PROVIDER_NAME=OpenAI
